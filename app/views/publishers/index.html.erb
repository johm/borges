<h1>Publishers</h1>

<table class="table">
  <tr>
    <th>Name</th>
    <th># of Editions</th>
    <th></th>
  </tr>

<% @publishers.each do |publisher| %>
  <tr>
    <td><%= link_to publisher.name,publisher %></td>
    <td><%= publisher.editions.count %></td>
    <td><%= number_to_percentage(Copy.sell_through_rate(publisher.copies,90)*100) %></td>
  </tr>
<% end %>
</table>

<br />

<%= link_to 'New Publisher', new_publisher_path %>
